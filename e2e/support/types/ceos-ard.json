{
  "id": "ceos-ard",
  "title": "CEOS-ARD",
  "description": "Product Family Specifications for CEOS Analysis Ready Data",
  "available": true,
  "color": "#3e5265",
  "upstream": {
    "owner": "ceos-org",
    "repo": "ceos-ard",
    "branch": "main",
    "url": "https://github.com/ceos-org/ceos-ard"
  },
  "preview": "build",
  "selection": {
    "label": "PFS",
    "multiple": true,
    "on_create": true
  },
  "downloads": ["pdf", "docx"],
  "expanded_folders": [],
  "labels": {},
  "editors": [
    {
      "match": "glossary/*.yaml",
      "codec": "yaml",
      "schema": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 2
          },
          "description": {
            "type": "string",
            "minLength": 2,
            "description": "Markdown is supported for formatting."
          }
        }
      },
      "ui_schema": {
        "type": "VerticalLayout",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/term",
            "options": {
              "clearable": false
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/description",
            "options": {
              "clearable": false
            }
          }
        ]
      }
    }
  ],
  "search_filters": [],
  "actions": [
    {
      "id": "create-pfs",
      "title": "Add New PFS",
      "folder": "/pfs",
      "schema": {
        "type": "object",
        "required": ["id", "title", "type"],
        "properties": {
          "id": {
            "type": "string",
            "title": "ID",
            "pattern": "^[A-Z0-9]{2,10}$",
            "description": "The name of the new PFS folder: 2 to 10 capital letters or digits, e.g. NRB"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "minLength": 1,
            "maxLength": 100,
            "description": "e.g. Normalised Radar Backscatter"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "enum": ["SAR", "Optical"]
          },
          "applies_to": {
            "type": "string",
            "title": "Applies To",
            "maxLength": 2000,
            "description": "e.g. Data collected by Synthetic Aperture Radar sensors"
          },
          "base": {
            "type": "string",
            "title": "Base PFS",
            "description": "Copies this PFS of the workspace as the start of the new one"
          }
        }
      },
      "ui_schema": {
        "type": "VerticalLayout",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/id"
          },
          {
            "type": "Control",
            "scope": "#/properties/title"
          },
          {
            "type": "Control",
            "scope": "#/properties/type"
          },
          {
            "type": "Control",
            "scope": "#/properties/applies_to",
            "options": {
              "multi": true
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/base"
          }
        ]
      }
    }
  ],
  "file_menu": [
    {
      "match": "**",
      "kind": "folder",
      "ops": ["create", "rename", "delete"],
      "ops_if_new": []
    },
    {
      "match": "**",
      "kind": "file",
      "ops": ["open_source", "download", "diff", "revert", "rename", "delete"],
      "ops_if_new": []
    },
    {
      "match": "pfs",
      "kind": "folder",
      "ops": [],
      "ops_if_new": []
    },
    {
      "match": "pfs/*",
      "kind": "folder",
      "ops": [],
      "ops_if_new": ["rename", "delete"]
    },
    {
      "match": "pfs/**",
      "kind": "file",
      "ops": ["open_source", "download", "diff", "revert"],
      "ops_if_new": []
    }
  ]
}
