# This should point to the backend API server. It must be on the same site as the editor (same
# registrable domain, e.g. editor.example.org and api.example.org; both on localhost in development),
# otherwise browsers may block the login cookie as a third-party cookie.
VITE_API_BASE_URL=http://localhost:8000

# Name and tagline of this deployment, shown on the landing page and as page title
# VITE_APP_TITLE=CEOS-ARD Editor
# VITE_APP_SUBTITLE=Collaborative Product Specification Editor for CEOS Analysis Ready Data
