# This should point to the backend API server. It must be on the same site as the editor (same
# registrable domain, e.g. editor.example.org and api.example.org; both on localhost in development),
# otherwise browsers may block the login cookie as a third-party cookie.
VITE_API_BASE_URL=http://localhost:8000

# Name and tagline of this deployment, shown on the landing page and as page title
# VITE_APP_TITLE=CEOS-ARD Editor
# VITE_APP_SUBTITLE=Collaborative Product Specification Editor for CEOS Analysis Ready Data

# The notice at the top of the landing page, the prototype notice if empty
# VITE_APP_NOTICE=This is an unofficial demo. Data may be reset at any time.
# The logo on the landing page: a URL, "none" for no logo, the CEOS-ARD logo if empty
# VITE_APP_LOGO=none
# Links on the landing page before moreGeo and the imprint, as "Title|URL" separated by ";", the CEOS links if empty
# VITE_APP_LINKS=CEOS-ARD Website|https://ceos.org/ard/;CEOS GitHub Organization|https://github.com/ceos-org
